rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/siteAdmins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/siteAdmins/$(request.auth.uid)).data.enabled == true;
    }
    match /admin-images/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && request.auth.uid == uid && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if isAdmin();
    }
  }
}
