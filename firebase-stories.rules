rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /communityStories/{storyId} {
      function validStory() {
        let d = request.resource.data;
        return d.keys().hasAll(['title','type','content','authorId','authorName','status','createdAt','updatedAt'])
          && d.keys().hasOnly(['title','type','content','authorId','authorName','status','createdAt','updatedAt'])
          && d.authorId == request.auth.uid
          && d.title is string && d.title.size() > 0 && d.title.size() <= 160
          && d.content is string && d.content.size() > 0 && d.content.size() <= 100000
          && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 100
          && d.type in ['novel','play','poem'] && d.status == 'published'
          && d.createdAt is timestamp && d.createdAt <= request.time
          && d.updatedAt == request.time;
      }
      allow read: if resource.data.status == 'published' || (request.auth != null && resource.data.authorId == request.auth.uid);
      allow create: if request.auth != null && validStory();
      allow update: if request.auth != null && resource.data.authorId == request.auth.uid && validStory()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
  }
}
